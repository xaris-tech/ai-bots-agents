# Local application
APP_ENV=development
APP_TIMEZONE=America/Chicago
OPERATOR_DISPLAY_NAME=CEO
BID_DATABASE_PATH=data/bid-copilot.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OpenAI (bid copilot agent model, via ADK's LiteLLM wrapper)
# Needs an API key from platform.openai.com with its own billing — a ChatGPT
# subscription login does not grant API access.
OPENAI_API_KEY=

# Optional Google Cloud telemetry (disabled for local use)
ENABLE_CLOUD_TELEMETRY=false

# Playwright portal access
HEADLESS=0
PLAYWRIGHT_USER_DATA_DIR=playwright/.auth/cortex-portals
IONWAVE_USERNAME=
IONWAVE_PASSWORD=
DEMANDSTAR_USERNAME=
DEMANDSTAR_PASSWORD=
BONFIRE_USERNAME=
BONFIRE_PASSWORD=
BONFIRE_COUNTIES=Tarrant County,Dallas County,Denton County,Ellis County,Johnson County,Parker County,Wise County
BONFIRE_MAX_AGENCIES=40
BONFIRE_REQUEST_DELAY_MS=2000

# Public Purchase credentials from the secure credential store. Do not copy
# passwords into config/sites.json or the source workbook.
PUBLIC_PURCHASE_USERNAME=
PUBLIC_PURCHASE_PASSWORD=
# A site can use its own account: point its profile's auth.usernameEnv /
# auth.passwordEnv at dedicated variables, for example:
# PUBLIC_PURCHASE_HURST_USERNAME=
# PUBLIC_PURCHASE_HURST_PASSWORD=

# CivCast has no adapter yet. BidNet's adapter (src/scrapers/bidnet.mjs)
# scrapes the public open-bids listing and does not currently use these.
CIVCAST_USERNAME=
CIVCAST_PASSWORD=
BIDNET_USERNAME=
BIDNET_PASSWORD=

# Google Sheets destination. GOOGLE_SERVICE_ACCOUNT_KEY_FILE should point at a
# gitignored path (this repo uses credentials/cortex-sa.json, not the older
# config/service-account.json default) — the Sheets API must be enabled on
# that service account's GCP project or every push fails with a 403.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials/cortex-sa.json
GOOGLE_SHEETS_SPREADSHEET_ID=1mtPEx2C_bHFGYoEFcc0gIsqr_KyW8fStxxhp3JQ5584
GOOGLE_SHEETS_BIDS_TAB=Bids

# ClickUp destination. The live workspace has a "Bid Opportunities" space
# with two flat lists (Aggregates Supply, General Construction) — their IDs
# are hardcoded in scripts/push-clickup-tasks.mjs, not read from env. The
# CLICKUP_*_LIST_ID vars below are unused leftovers from an earlier planned
# folder structure (docs/clickup-manual-setup.md) that was never built.
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=9011646920
CLICKUP_DEFAULT_ASSIGNEE_ID=114218682
CLICKUP_IONWAVE_LIST_ID=
CLICKUP_DEMANDSTAR_LIST_ID=
CLICKUP_BONFIRE_LIST_ID=
CLICKUP_CEO_REVIEW_LIST_ID=

# --- Auth (Firebase passwordless email-link + email allowlist) ---
# AUTH_ENABLED=false disables all API auth (LOCAL DEV ONLY; default is ON).
AUTH_ENABLED=true
# Comma-separated allowlist (defaults to the two operators if unset).
AUTH_ALLOWED_EMAILS=ranjovidad@gmail.com,info@cortexconstruction.com
# ID-token verification: point at a Firebase service-account JSON (preferred),
# or set FIREBASE_PROJECT_ID and rely on Application Default Credentials.
FIREBASE_CREDENTIALS=credentials/firebase-sa.json
FIREBASE_PROJECT_ID=
