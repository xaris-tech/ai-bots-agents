# Telegram
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OnlineJobs.ph pages to watch. Use commas for multiple pages.
# Examples:
# https://www.onlinejobs.ph/jobseekers/search/c/virtual-assistant
# https://www.onlinejobs.ph/jobseekers/search/c/web-development
OLJ_SEARCH_URLS=https://www.onlinejobs.ph/jobseekers/search/c/virtual-assistant

# Optional: flexible keyword searches. The bot converts each keyword into
# https://www.onlinejobs.ph/jobseekers/jobsearch?jobkeyword=...
OLJ_SEARCH_KEYWORDS=

# Match jobs by title, skills, or description snippets. Comma-separated.
JOB_KEYWORDS=virtual assistant,executive assistant,customer support

# Optional negative keywords. Matching jobs will be skipped.
EXCLUDE_KEYWORDS=crypto,commission only,unpaid

# Your applicant profile. Used to generate detailed application messages.
APPLICANT_NAME=
APPLICANT_EXPERIENCE=
APPLICANT_SKILLS=
APPLICANT_TOOLS=
APPLICANT_AVAILABILITY=
APPLICANT_PORTFOLIO=
APPLICANT_RATE=

# Runtime behavior
CHECK_INTERVAL_SECONDS=300
DATABASE_PATH=data/oljwatcher.sqlite3
USER_AGENT=oljwatcher/0.1 (+https://www.onlinejobs.ph)

# Optional OnlineJobs.ph authenticated browser cookie.
# Use this instead of storing your OnlineJobs.ph password.
OLJ_COOKIE=
OLJ_EMAIL=
OLJ_PASSWORD=

# Optional AI drafting through Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
APPLICATION_STYLE=developer

# Optional one-time baseline cutoff.
# Normally leave this blank after the initial database has been seeded.
# SQLite seen_jobs is what prevents repeat alerts day to day.
# Format: YYYY-MM-DD HH:MM:SS
NOTIFY_POSTED_AFTER=
